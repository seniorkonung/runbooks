- id: 8a5252e8-4660-447a-8044-0b75ebd28dc7
  type: script
  props:
    interpreter: bash
    outputVariable: ''
    name: Скачать и установить mise
    code: |-
      curl https://mise.run | sh
      ln -s ~/.local/bin/mise /usr/local/bin
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
- id: e2d26a47-436d-43ff-948e-4b95c258eaff
  type: script
  props:
    interpreter: bash
    outputVariable: ''
    name: Обновить .bashrc
    code: |-
      echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
      echo 'eval "$(mise activate bash)"' >> ~/.bashrc
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
