    value: paseo.seniorkonung.uk
  children: []
- id: 5b708786-6136-4f98-a99c-42425daf866e
  type: script
  props:
    interpreter: bash
    outputVariable: ''
    name: Регистрация и запуск автоматической службы paseo
    code: |-
      mkdir -p /root/.config/paseo /root/.paseo

      cat > /root/.config/paseo/credentials.env <<'EOF'
      PASEO_PASSWORD={{var.paseo_password}}
      EOF
      chmod 600 /root/.config/paseo/credentials.env

      cat > /root/.paseo/config.json <<'EOF'
      {
        "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
        "version": 1,
        "daemon": {
          "listen": "127.0.0.1:6767",
          "hostnames": [
            "paseo.seniorkonung.uk"
          ],
          "relay": {
            "enabled": false
          }
        },
        "features": {
          "dictation": {
            "enabled": false
          },
          "voiceMode": {
            "enabled": false
          }
        }
      }
      EOF

      cat > /etc/systemd/system/paseo.service <<'EOF'
      [Unit]
      Description=Paseo Daemon
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=root
      EnvironmentFile=/root/.config/paseo/credentials.env
      ExecStart=/root/.local/bin/mise exec -- paseo daemon start --foreground
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=default.target
      EOF

      systemctl daemon-reload
      systemctl enable --now paseo.service
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
