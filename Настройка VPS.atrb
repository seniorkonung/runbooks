- id: b99dc036-c417-4ca8-8745-2d7fbf4b3a8e
  type: script
  props:
    interpreter: bash
    outputVariable: ''
    name: Настройка codex-asr
    code: |-
      mkdir -p /root/.config/codex-asr

      cat > /root/.config/codex-asr/token.env <<'EOF'
      CODEX_ASR_TOKEN={{var.codex_asr_token}}
      EOF
      chmod 600 /root/.config/codex-asr/token.env

      cat > /etc/systemd/system/codex-asr.service <<'EOF'
      [Unit]
      Description=Run codex-asr server

      [Service]
      Type=simple
      User=root
      EnvironmentFile=/root/.config/codex-asr/token.env
      ExecStart=/root/.local/bin/mise exec -- codex-asr serve --api-key ${CODEX_ASR_TOKEN} --host 127.0.0.1 --port 8788 --concurrency 16
      Restart=always
      RestartSec=3

      [Install]
      WantedBy=default.target
      EOF

      systemctl daemon-reload
      systemctl enable --now codex-asr.service
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
