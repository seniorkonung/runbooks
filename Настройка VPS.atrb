- id: 656e666b-561f-4b15-b109-e0e0f59c34be
  type: script
  props:
    interpreter: bash
    outputVariable: ''
    name: Установить зависимости и настроить git на обновление credentials
    code: |-
      apt-get update -y
      apt-get install -y curl jq openssl

      cat > /usr/local/bin/git-credential-github-app <<'EOF'
      #!/usr/bin/env bash
      set -euo pipefail

      CLIENT_ID="{{ env.GITHUB_APP_CLIENT_ID }}"
      PRIVATE_KEY="/root/.config/github-app/private-key.pem"

      ACTION="${1:-get}"

      # Git может вызывать helper с get/store/erase.
      # Нам нужен только get.
      if [[ "$ACTION" != "get" ]]; then
          exit 0
      fi

      protocol=""
      host=""
      path=""

      while IFS='=' read -r key value; do
          case "$key" in
              protocol) protocol="$value" ;;
              host)     host="$value" ;;
              path)     path="$value" ;;
          esac
      done

      if [[ "$host" != "github.com" ]]; then
          exit 0
      fi

      repo_path="${path%.git}"
      owner="${repo_path%%/*}"
      repo="${repo_path#*/}"

      if [[ -z "$owner" || -z "$repo" || "$owner" == "$repo" ]]; then
          echo "GitHub App credential helper: cannot determine repository from '$path'" >&2
          exit 1
      fi

      b64url() {
          openssl base64 -A | tr '+/' '-_' | tr -d '='
      }

      now=$(date +%s)
      iat=$((now - 60))
      exp=$((now + 540))

      header=$(
          printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url
      )

      payload=$(
          printf '{"iat":%d,"exp":%d,"iss":"%s"}' \
              "$iat" "$exp" "$CLIENT_ID" | b64url
      )

      unsigned="${header}.${payload}"

      signature=$(
          printf '%s' "$unsigned" \
          | openssl dgst -sha256 -sign "$PRIVATE_KEY" \
          | b64url
      )

      jwt="${unsigned}.${signature}"

      installation_id=$(
          curl -fsS \
              -H "Accept: application/vnd.github+json" \
              -H "Authorization: Bearer $jwt" \
              -H "X-GitHub-Api-Version: 2026-03-10" \
              "https://api.github.com/repos/${owner}/${repo}/installation" \
          | jq -r '.id'
      )

      token=$(
          curl -fsS \
              -X POST \
              -H "Accept: application/vnd.github+json" \
              -H "Authorization: Bearer $jwt" \
              -H "X-GitHub-Api-Version: 2026-03-10" \
              "https://api.github.com/app/installations/${installation_id}/access_tokens" \
          | jq -r '.token'
      )

      printf 'username=x-access-token\n'
      printf 'password=%s\n\n' "$token"
      EOF

      chmod 755 /usr/local/bin/git-credential-github-app

      git config --global credential.https://github.com.useHttpPath true
      git config --global credential.https://github.com.helper github-app

      git config --global user.name "senior-chicken[bot]"
      git config --global user.email "319589311+senior-chicken[bot]@users.noreply.github.com"
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
