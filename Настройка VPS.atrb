- id: fc686b3e-6177-4b53-8356-79ca8cf5f61d
  type: run
  props:
    type: bash
    name: Получение PEM Private Key
    code: |-
      mkdir -p /root/.config/github-app \
        && cat > /root/.config/github-app/private-key.pem \
        && chmod 600 /root/.config/github-app/private-key.pem
    pty: ''
    global: false
    outputVisible: true
    dependency: '{}'
    terminalRows: 20
  children:
  - id: e9988c52-534e-4666-8883-2a630e5eeae8
