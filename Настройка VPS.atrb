- id: 0565a148-4239-4cc8-8269-2709626f38e6
  type: script
  props:
    interpreter: bash
    outputVariable: ''
    name: Установка всех зависимостей поочерёдная
    code: |-
      export PATH="/root/.local/bin:$PATH"
      mise use -g rust codex cloudflared
      mise use -g cargo:codex-asr
      mise use -g node
      mise use -g npm:@getpaseo/cli
    outputVisible: true
    dependency: '{}'
    terminalRows: 16
  children: []
