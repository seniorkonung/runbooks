- id: e2d26a47-436d-43ff-948e-4b95c258eaff
  type: script
  props:
    interpreter: bash
    outputVariable: ''
    name: Обновить .bashrc
    code: |-
      echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
      echo 'eval "$(mise activate bash)"' >> ~/.bashrc
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
