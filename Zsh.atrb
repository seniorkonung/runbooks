- id: 5122b0b6-420b-4a71-8b62-a841483dde93
  type: run
  props:
    type: bash
    name: Установка zsh как оболочки по умолчанию
    code: sudo chsh -s /usr/bin/zsh $USER
    pty: ''
    global: false
    outputVisible: true
    dependency: '{}'
    terminalRows: 20
  children: []
- id: bbab0163-afe5-4ed0-8fb7-c2723674d035
  type: script
  props:
    interpreter: /usr/bin/zsh
    outputVariable: ''
    name: Создать файлы конфигурации
    code: touch .zshrc .zshenv && chmod "0644" .zshrc .zshenv
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
- id: 39ed7ab2-6954-4747-95bf-8fc01b503727
  type: script
  props:
    interpreter: /usr/bin/zsh
    outputVariable: ''
    name: Установка oh-my-zsh
    code: sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
    outputVisible: false
    dependency: '{}'
    terminalRows: 12
  children: []
- id: 4d203439-a215-4c53-a746-93f0c482684a
  type: run
  props:
    type: bash
    name: Скачивание дополнительных плагинов
    code: |-
      git clone https://github.com/zsh-users/zsh-autosuggestions.git $ZSH/plugins/zsh-autosuggestions \
        && git clone https://github.com/zsh-users/zsh-completions.git $ZSH/plugins/zsh-completions \
        && git clone https://github.com/zsh-users/zsh-syntax-highlighting.git $ZSH/plugins/zsh-syntax-highlighting
    pty: ''
    global: false
    outputVisible: true
    dependency: '{}'
    terminalRows: 20
  children: []
- id: 140528a9-d35a-4ffe-8e93-4b3e759cc2ec
  type: script
  props:
    interpreter: /usr/bin/zsh
    outputVariable: ''
    name: Сохранить новую конфигурацию
    code: |-
      cat << EOF > .zshrc
      export ZSH=~/.oh-my-zsh

      fpath=(\$ZSH/plugins/zsh-completions/src \$fpath)

      ZSH_THEME="agnoster"
      ZSH_AUTOSUGGEST_STRATEGY="completion"

      plugins=(
        git
        zsh-syntax-highlighting
        zsh-autosuggestions
        zsh-completions
        rust
        node
        npm
        bun
        docker
        zsh-interactive-cd
        mise
      )

      source \$ZSH/oh-my-zsh.sh

      export PATH=$PATH:$HOME/.local/bin
      EOF
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
- id: 6d45c9bb-9c8a-4211-af02-9eb5f53d8c22
  type: run
  props:
    type: bash
    name: Установить шрифт powerline (для стандартного терминала)
    code: sudo apt install -y fonts-powerline
    pty: ''
    global: false
    outputVisible: true
    dependency: '{}'
    terminalRows: 20
  children: []
