- id: 69937f48-280e-4b89-8866-bc0b0dc77d65
  type: script
  props:
    interpreter: /usr/bin/zsh
    outputVariable: ''
    name: Настройка navi
    code: |-
      [ -d $HOME/projects/cheats/.git ] || git clone git@github.com:seniorkonung/cheats.git

      mkdir -p ~/.config/navi
      cat > ~/.config/navi/config.yaml <<'EOF'
      cheats:
        paths:
          - ~/projects/cheats
      EOF
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
