  props:
    interpreter: /usr/bin/zsh
    outputVariable: ''
    name: Обновить .zshrc
    code: echo 'eval "$(~/.local/bin/mise activate zsh)"' >> ~/.zshrc
    outputVisible: true
    dependency: '{}'
    terminalRows: 12
  children: []
- id: f8acb874-a7b2-42e2-83f4-0efdc8e33f35
  type: run
  props:
    type: bash
    name: Установить утилиту усиливающую автоподсказки
    code: mise use -g usage
    pty: ''
    global: false
